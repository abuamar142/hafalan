# Salin ke .env lalu isi nilainya.
# JANGAN commit file .env yang berisi nilai asli.

POSTGRES_USER=hafalan
POSTGRES_PASSWORD=ganti_dengan_password_kuat
POSTGRES_DB=hafalan-db

# Koneksi dari host (untuk migrasi/drizzle-kit). Di dalam container app,
# docker-compose menimpanya menjadi host "db".
DATABASE_URL=postgres://hafalan:ganti_dengan_password_kuat@127.0.0.1:5440/hafalan-db

# Rahasia penandatangan sesi (JWT). Buat acak: openssl rand -base64 48
JWT_SECRET=ganti_dengan_string_acak_panjang
